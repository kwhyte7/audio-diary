# Copy this file to .env and change anything you like:
#   cp .env.example .env
#
# docker compose reads .env automatically for these values.

# --------------------------------------------------------------------------
# App
# --------------------------------------------------------------------------

# Port the web UI is served on (your machine).
APP_PORT=8082

# Full connection string the app uses. By default it points at the bundled
# Postgres service. If you already have Postgres on your host, point this at
# it instead, e.g.:
#   DATABASE_URL=postgresql://user:pass@host.docker.internal:5432/audio_diary
DATABASE_URL=postgresql://postgres:postgres@db:5432/audio_diary

# Flask session signing key. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# --------------------------------------------------------------------------
# Bundled Postgres service
# --------------------------------------------------------------------------

# Port the bundled Postgres listens on from your machine. Change this if
# something else (like a local Postgres) is already using 5432.
POSTGRES_PORT=5432

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=audio_diary
